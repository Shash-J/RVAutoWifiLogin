{
  "manifest_version": 3,
  "name": "RVCE WiFi Auto-Login",
  "version": "2.1.0",
  "description": "Autonomous State-Machine Auto-Login and Session Refresh Engine for RVCE WiFi",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://172.16.0.2:1003/*",
        "http://172.16.0.2:1003/*"
      ],
      "run_at": "document_end",
      "js": ["content-script.js"]
    }
  ]
}
