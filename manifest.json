{
  "manifest_version": 3,
  "name": "RVCE WiFi Auto-Login",
  "version": "2.4.0",
  "description": "Autonomous State-Machine Auto-Login and Session Refresh Engine for RVCE WiFi (Sophos & Fortinet)",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://rvce-fw.rvce.edu.in/*",
        "*://172.16.0.4/*",
        "*://172.16.0.2/*"
      ],
      "run_at": "document_end",
      "js": ["content-script.js"]
    },
    {
      "matches": [
        "*://rvce-fw.rvce.edu.in/*",
        "*://172.16.0.4/*",
        "*://172.16.0.2/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["page-bridge.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
